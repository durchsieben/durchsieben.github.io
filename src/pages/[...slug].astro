---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = [...await getCollection('posts'), ...await getCollection('pages')];
  const routes = entries.map((entry) => ({
    params: { slug: decodeURI(entry.data.sourcePath.replace(/^\//, '').replace(/\/$/, '')) },
    props: { entry },
  }));
  const leadershipTechniques = entries.find((entry) => entry.data.sourcePath === '/2021/08/07/fuehrungstechniken/');
  if (!leadershipTechniques) throw new Error('missing Führungstechniken legacy route');
  return [
    ...routes,
    { params: { slug: '2021/08/07/🧰-fuhrungstechniken' }, props: { entry: leadershipTechniques } },
  ];
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = entry.data.sourcePath;
const isAbout = path === '/about/';
const isLegal = path === '/impressum/';
const isArticle = !isAbout && !isLegal;
const displayDate = isArticle
  ? new Date(`${entry.data.date.slice(0, 10)}T00:00:00Z`).toLocaleDateString('de-DE', {
      day: '2-digit',
      month: 'long',
      year: 'numeric',
    })
  : null;
const kicker = isAbout ? 'Über den Autor' : isLegal ? 'Rechtliche Hinweise' : 'Beitrag aus dem Archiv';
---
<BaseLayout title={entry.data.title} description={entry.data.title}>
  {isAbout || isLegal ? (
    <>
      <header class={`page-head${isAbout ? ' about-page-head' : ''}`}>
        <p class="hero__eyebrow">{kicker}</p>
        <h1>{entry.data.title}</h1>
      </header>
      <article class={`prose page-prose${isAbout ? ' about-prose' : ''}`}><Content /></article>
    </>
  ) : (
    <>
      <header class="article-head">
        <p class="kicker">{kicker}</p>
        <h1>{entry.data.title}</h1>
        <p class="byline">
          {displayDate}
          <span class="dot" aria-hidden="true">·</span>
          <a href="/">← Zurück zum Archiv</a>
        </p>
      </header>
      <article class="prose"><Content /></article>
    </>
  )}
</BaseLayout>
