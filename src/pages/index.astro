---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchAndFeed from '../components/SearchAndFeed.astro';
import { newestFirst, topics } from '../lib/posts';

const posts = await newestFirst();
const topicList = topics(posts);
const lead = `${posts.length} kuratierte Beiträge zu Führung, Organisation und Entscheidung. Lesen statt scrollen – wie in einem Magazin, aber ruhig.`;
---
<BaseLayout title="Startseite" description={lead}>
  <section class="hero">
    <p class="hero__eyebrow">Management÷7 · Archiv</p>
    <h1>Zusammenhänge verstehen. Klarer führen.</h1>
    <p class="lead">{lead}</p>
    <SearchAndFeed posts={posts} topics={topicList} feedTitle="Neueste Beiträge" feedEyebrow="Aktuell" />
  </section>
</BaseLayout>
