---
import type { PostSummary } from '../lib/posts';
import { INITIAL_FEED } from '../lib/posts';

interface Props {
  posts: PostSummary[];
  topics: { slug: string; label: string; count: number }[];
  feedTitle: string;
  feedEyebrow?: string;
}

const { posts, topics, feedTitle, feedEyebrow } = Astro.props;
const initial = posts.slice(0, INITIAL_FEED);
const remaining = Math.max(0, posts.length - initial.length);
---
<section class="search" aria-label="Artikel suchen">
  <label class="search__label" for="post-search">Im Archiv suchen</label>
  <div class="search__box">
    <svg class="search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <line x1="20" y1="20" x2="16.65" y2="16.65"></line>
    </svg>
    <input
      id="post-search"
      class="search__input"
      type="search"
      placeholder="Begriff, Thema oder den Anfang eines Titels …"
      autocomplete="off"
      spellcheck="false"
      data-search-input
    />
    <button class="search__clear" type="button" data-search-clear hidden>zurücksetzen</button>
  </div>
  <p class="search__hint" data-search-hint>
    {posts.length} Beiträge · neueste zuerst · die ersten {initial.length} geladen
  </p>
  <div class="topics" role="group" aria-label="Themenfilter">
    {topics.map((topic: { slug: string; label: string; count: number }) => (
      <button
        type="button"
        class="topic-pill"
        data-topic-pill
        data-topic={topic.slug}
        aria-pressed="false"
      >
        <span>{topic.label}</span>
        <span class="count">{topic.count}</span>
      </button>
    ))}
  </div>
</section>

<section class="feed-section" aria-live="polite">
  <header class="feed-head">
    <div>
      {feedEyebrow && <p class="feed-meta">{feedEyebrow}</p>}
      <h2 data-feed-title>{feedTitle}</h2>
    </div>
    <p class="feed-meta" data-feed-count>{initial.length} von {posts.length} Beiträge</p>
  </header>
  <div
    class="feed"
    data-feed-list
    data-feed-total={posts.length}
    data-feed-page={INITIAL_FEED}
    id="posts"
  >
    {initial.map((post: PostSummary) => (
      <article class="feed__row" data-article-row data-article={post.path}>
        <div class="feed__col feed__col--left">
          <p class="feed__meta">
            <time datetime={post.isoDate}>{post.displayDate}</time>
            <span class="dot" aria-hidden="true"></span>
            <span>{post.minutes} Min Lesedauer</span>
            <span class="dot" aria-hidden="true"></span>
            <span>{post.year}</span>
          </p>
          <h3 class="feed__title">
            <a href={post.path} data-article-link data-original={post.title}>{post.title}</a>
          </h3>
        </div>
        <div class="feed__col feed__col--right">
          <p class="feed__excerpt" data-article-excerpt data-original={post.excerpt}>{post.excerpt}</p>
        </div>
      </article>
    ))}
  </div>
  {remaining > 0 && (
    <button class="feed-more" type="button" data-feed-more>
      Weitere Beiträge · {remaining} übrig
    </button>
  )}
  <p class="feed-empty" data-feed-empty hidden>Kein Beitrag passt zu deiner Suche.</p>
</section>

<script>
  type Topic = { slug: string; label: string };
  type PostSummary = {
    path: string;
    title: string;
    isoDate: string;
    displayDate: string;
    year: string;
    excerpt: string;
    minutes: number;
    searchText: string;
  };

  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-search-clear]');
  const hint = document.querySelector<HTMLParagraphElement>('[data-search-hint]');
  const list = document.querySelector<HTMLElement>('[data-feed-list]');
  const countEl = document.querySelector<HTMLElement>('[data-feed-count]');
  const titleEl = document.querySelector<HTMLElement>('[data-feed-title]');
  const emptyEl = document.querySelector<HTMLElement>('[data-feed-empty]');
  const moreBtn = document.querySelector<HTMLButtonElement>('[data-feed-more]');
  const feedTitleDefault = titleEl?.textContent?.trim() ?? '';
  const pills = document.querySelectorAll<HTMLButtonElement>('[data-topic-pill]');
  const topics: Topic[] = [...pills].map((pill) => ({
    slug: pill.dataset.topic ?? '',
    label: pill.querySelector('span')?.textContent?.trim() ?? '',
  }));
  const total = Number(list?.dataset.feedTotal ?? 0);
  const pageSize = Number(list?.dataset.feedPage ?? 20);
  let visibleCount = list?.querySelectorAll('[data-article-row]').length ?? 0;
  let catalog: PostSummary[] | null = null;
  let catalogPromise: Promise<PostSummary[]> | null = null;
  let activeQuery = '';
  let activeTopic: string | null = null;

  function escapeHtml(value: string): string {
    return value.replace(/[&<>\"']/g, (char) => {
      switch (char) {
        case '&': return '&amp;';
        case '<': return '&lt;';
        case '>': return '&gt;';
        case '"': return '&quot;';
        case "'": return '&#39;';
        default: return char;
      }
    });
  }

  function highlight(text: string, terms: string[]): string {
    if (!terms.length) return escapeHtml(text);
    const pattern = terms
      .filter((term) => term.length > 0)
      .map((term) => term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
      .join('|');
    if (!pattern) return escapeHtml(text);
    return escapeHtml(text).replace(new RegExp(`(${pattern})`, 'gi'), '<mark>$1</mark>');
  }

  function loadIndex(): Promise<PostSummary[]> {
    if (catalog) return Promise.resolve(catalog);
    if (!catalogPromise) {
      catalogPromise = fetch('/search-index.json')
        .then((response) => {
          if (!response.ok) throw new Error('search-index');
          return response.json() as Promise<PostSummary[]>;
        })
        .then((posts) => {
          catalog = posts;
          return posts;
        })
        .catch((error) => {
          catalogPromise = null;
          throw error;
        });
    }
    return catalogPromise;
  }

  function rowFor(post: PostSummary, terms: string[]): HTMLElement {
    const row = document.createElement('article');
    row.className = 'feed__row';
    row.dataset.article = post.path;
    row.innerHTML =
      `<div class="feed__col feed__col--left">` +
      `<p class="feed__meta"><time datetime="${escapeHtml(post.isoDate)}">${escapeHtml(post.displayDate)}</time>` +
      `<span class="dot" aria-hidden="true"></span><span>${post.minutes} Min Lesedauer</span>` +
      `<span class="dot" aria-hidden="true"></span><span>${escapeHtml(post.year)}</span></p>` +
      `<h3 class="feed__title"><a href="${escapeHtml(post.path)}" data-article-link data-original="${escapeHtml(post.title)}">${highlight(post.title, terms)}</a></h3>` +
      `</div><div class="feed__col feed__col--right">` +
      `<p class="feed__excerpt" data-article-excerpt data-original="${escapeHtml(post.excerpt)}">${highlight(post.excerpt, terms)}</p>` +
      `</div>`;
    return row;
  }

  function termsOf(query: string): string[] {
    return query.trim().toLowerCase().split(/\s+/).filter((part) => part.length > 0);
  }

  function matching(posts: PostSummary[]): PostSummary[] {
    const terms = termsOf(activeQuery);
    return posts.filter((post) => {
      if (activeTopic && !post.searchText.includes(activeTopic.toLowerCase())) return false;
      return terms.every((term) => post.searchText.includes(term));
    });
  }

  function updateChrome(shown: number, filtering: boolean): void {
    if (countEl) {
      countEl.textContent = filtering ? `${shown} Beiträge` : `${shown} von ${total} Beiträge`;
    }
    if (titleEl) {
      titleEl.textContent = filtering ? (shown ? 'Suchergebnisse' : 'Keine Treffer') : feedTitleDefault;
    }
    if (emptyEl) emptyEl.hidden = shown > 0;
    if (clearBtn) clearBtn.hidden = !filtering;
    if (moreBtn) moreBtn.hidden = filtering || shown >= total;
    if (moreBtn && !filtering && shown < total) {
      moreBtn.textContent = `Weitere Beiträge · ${total - shown} übrig`;
    }
    if (hint) {
      if (!filtering) {
        hint.textContent = `${total} Beiträge · neueste zuerst · die ersten ${shown} geladen`;
      } else {
        const parts: string[] = [];
        if (activeQuery) parts.push(`Suche: „${activeQuery}“`);
        if (activeTopic) {
          const topic = topics.find((item) => item.slug === activeTopic);
          if (topic) parts.push(`Thema: ${topic.label}`);
        }
        parts.push(`${shown} Treffer`);
        hint.textContent = parts.join(' · ');
      }
    }
  }

  function renderSlice(posts: PostSummary[], terms: string[]): void {
    if (!list) return;
    list.replaceChildren();
    const fragment = document.createDocumentFragment();
    for (const post of posts) fragment.appendChild(rowFor(post, terms));
    list.appendChild(fragment);
  }

  async function applyFilter(): Promise<void> {
    const filtering = Boolean(activeQuery.trim() || activeTopic);
    if (!filtering) {
      if (catalog) renderSlice(catalog.slice(0, visibleCount), []);
      updateChrome(visibleCount, false);
      return;
    }
    const posts = await loadIndex();
    const hits = matching(posts);
    renderSlice(hits, termsOf(activeQuery));
    updateChrome(hits.length, true);
  }

  async function revealMore(): Promise<void> {
    const posts = await loadIndex();
    if (!list) return;
    const next = posts.slice(visibleCount, visibleCount + pageSize);
    const fragment = document.createDocumentFragment();
    for (const post of next) fragment.appendChild(rowFor(post, []));
    list.appendChild(fragment);
    visibleCount = Math.min(total, visibleCount + pageSize);
    updateChrome(visibleCount, false);
  }

  if (input) {
    input.addEventListener('input', () => {
      activeQuery = input.value;
      void applyFilter();
    });
  }

  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      if (input) input.value = '';
      activeQuery = '';
      void applyFilter();
      input?.focus();
    });
  }

  if (moreBtn) {
    moreBtn.addEventListener('click', () => {
      void revealMore();
    });
  }

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const slug = pill.dataset.topic ?? '';
      if (activeTopic === slug) {
        activeTopic = null;
        pill.setAttribute('aria-pressed', 'false');
      } else {
        pills.forEach((other) => other.setAttribute('aria-pressed', 'false'));
        activeTopic = slug;
        pill.setAttribute('aria-pressed', 'true');
      }
      void applyFilter();
    });
  });

  const idle = window.requestIdleCallback ?? ((callback: () => void) => window.setTimeout(callback, 1));
  idle(() => {
    void loadIndex();
  });

  (window as unknown as { __searchState: unknown }).__searchState = {
    get query() { return activeQuery; },
    get topic() { return activeTopic; },
    count: () => list?.querySelectorAll('[data-article-row]').length ?? 0,
  };
</script>
